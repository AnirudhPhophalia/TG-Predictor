# MongoDB Atlas Connection
# Get your connection string from: https://www.mongodb.com/cloud/atlas
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/thapar-grade-predictor?retryWrites=true&w=majority"

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web Application)
# 4. Add authorized JavaScript origins and redirect URIs
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# Email Configuration (Gmail)
# To use Gmail: Generate an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@thapar-grade-predictor.com"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"

# Thapar Institute Email Domain
# Only students with this domain can login
THAPAR_EMAIL_DOMAIN="thapar.edu"

# Grade Prediction Settings
# Predictions activate after this many submissions per subject
MINIMUM_SUBMISSIONS_FOR_PREDICTION="100"

# Feature Flags
ENABLE_NOTIFICATIONS="true"
ENABLE_EDIT_REQUESTS="true"

# Node Environment
NODE_ENV="development"
